rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // เดิมพยายามอ่านข้อมูลบัญชีโค้ชจาก Firestore ข้ามบริการผ่าน firestore.get() เหมือน firestore.rules ทุกประการ
    // แต่พบว่า cross-service call แบบนี้ไม่เสถียร (ทดสอบจริงแล้วโดนปฏิเสธ storage/unauthorized แม้เป็นโค้ชทีมนั้น
    // จริงและไฟล์ผ่านทุกเงื่อนไข) จึงตัดมาเช็คแค่ "ล็อกอินจริง ไม่ใช่ anonymous" แทน — การจำกัดว่าใครเห็น/แก้ไข
    // ไฟล์ของทีมไหนยังคุมอยู่ที่ชั้นแอป (URL/path ที่ใช้จริงอิงจาก myTeam ของผู้ใช้เสมอ ไม่เปิดให้เลือกทีมอื่นได้)
    // และบัญชีทุกคนต้องผ่านการอนุมัติจากผู้ดูแลระบบก่อนถึงจะใช้งานแอปได้อยู่แล้ว
    function isSignedInCoach() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // ไฟล์แนบแผนการฝึกซ้อมรายวัน (รูป/PDF) แยกโฟลเดอร์ตามทีม — จำกัดขนาดไฟล์ไม่เกิน 10MB (ชนิดไฟล์คุมด้วย accept
    // ของ input ฝั่งหน้าเว็บแทน ไม่เช็ค request.resource.contentType ในชั้น rules เพราะพบว่า browser/OS บาง
    // เครื่องรายงาน content-type ของไฟล์เดียวกันไม่ตรงกับที่ฝั่ง client เห็น ทำให้ไฟล์ที่ถูกต้องถูกปฏิเสธเอง)
    match /trainingPlans/{team}/{allPaths=**} {
      allow read: if isSignedInCoach();
      allow create, update: if isSignedInCoach() && request.resource.size < 10 * 1024 * 1024;
      allow delete: if isSignedInCoach();
    }

    // รูปภาพแนบรายงานการฝึกซ้อม — เปิดใช้เฉพาะทีม THAWEE SC ตามคำขอ (ทีมอื่นยังไม่ต้องมีฟีเจอร์นี้) — ยังคง
    // ล็อก team == 'THAWEE SC' ไว้ในชั้น rules ได้ตามปกติ เพราะเทียบจาก path ตรงๆ ไม่ต้องพึ่ง cross-service call
    match /trainingReports/{team}/{allPaths=**} {
      allow read: if isSignedInCoach();
      allow create, update: if isSignedInCoach() && team == 'THAWEE SC' && request.resource.size < 10 * 1024 * 1024;
      allow delete: if isSignedInCoach();
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // หมายเหตุ: Firestore จะปฏิเสธ query (list) ที่ "ไม่กรอง" ด้วย where() ตรงกับเงื่อนไขใน rule
    // ทันที ถ้า rule นั้นอ้างอิง resource.data — แต่ถ้า query มี where() ตรงกับฟิลด์ที่ rule เช็ค
    // (เช่น where('team','==',myTeam)) จะอนุญาตตามปกติ (ทดสอบยืนยันแล้ว)
    // ผู้ดูแลระบบ (isAdmin) ไม่ผูกกับ resource.data เลย จึง query แบบไม่กรองได้เสมอ
    function isSignedIn() { return request.auth != null; }
    function isCoach() { return isSignedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous'; }
    function myCoachDoc() {
      return get(/databases/$(database)/documents/coaches/$(request.auth.uid)).data;
    }
    function myRole() { return myCoachDoc().role; }
    function isApproved() { return isCoach() && myCoachDoc().status == 'approved'; }
    function isAdmin() { return isCoach() && myRole() == 'admin'; }
    // โค้ช = จัดการข้อมูล (เขียนได้) / ผู้บริหารทีม = ดูอย่างเดียว (อ่านได้ เขียนไม่ได้)
    function canManageTeam() { return isApproved() && myRole() == 'coach'; }
    function canViewTeam() { return isApproved() && (myRole() == 'coach' || myRole() == 'executive'); }
    function myTeam() { return myCoachDoc().team; }
    function ownsTeam() { return 'team' in resource.data && resource.data.team == myTeam(); }

    // ทีมหลังบ้าน (role = 'staff') — สมัครเองด้วยอีเมลของตัวเอง ผู้ดูแลระบบหลักอนุมัติพร้อมกำหนดสิทธิ์รายคนไว้ใน coaches/{uid}.permissions
    // (รายการรหัส: view / coaches / manageTeams — ต้องตรงกับ js/staff-perms.js) เพิ่มเป็นเงื่อนไข "หรือ" ต่อท้ายเงื่อนไขเดิมเสมอ
    // ไม่แตะเงื่อนไขของแอดมิน/โค้ช/ผู้บริหารทีมเดิม และสิทธิ์ของแอดมินหลัก (isAdmin) ยังแยกขาด: ทีมหลังบ้านให้สิทธิ์ตัวเองหรือสร้าง
    // บัญชีแอดมิน/ทีมหลังบ้านไม่ได้ (ดูกฎ coaches ด้านล่าง) และใช้นัดประชุม/รอบทดสอบ/รอบ MASC/การแจ้งเตือนของแอดมินไม่ได้
    function isStaff() { return isApproved() && myRole() == 'staff'; }
    function hasPerm(p) { return isStaff() && 'permissions' in myCoachDoc() && p in myCoachDoc().permissions; }
    // manageTeams = แก้ข้อมูลทีมแทนโค้ชได้ทุกทีม (รวมอ่าน) / view = อ่านข้อมูลทุกทีมอย่างเดียว
    function canManageAll() { return isAdmin() || hasPerm('manageTeams'); }
    function canViewAll() { return isAdmin() || hasPerm('view') || hasPerm('manageTeams'); }

    match /coaches/{coachId} {
      allow read: if isSignedIn();
      // ผู้ลงทะเบียนใหม่สร้างโปรไฟล์ของตัวเองได้ (สถานะ pending) เลือกบทบาทได้แค่ coach/executive
      // (กำหนด admin หรือ team เองไม่ได้) ผู้ดูแลระบบเป็นผู้กำหนด team ให้ตอนอนุมัติ (หรือเปลี่ยนภายหลังได้)
      // โค้ชต้องระบุ coachPosition (Head Coach / Assistant Coach / GK Coach / Fitness Coach) และ ageGroups
      // (รุ่นอายุที่รับผิดชอบ อย่างน้อย 1 รุ่น) ตั้งแต่ตอนลงทะเบียน — Head Coach และ Assistant Coach ลงทะเบียน
      // เองได้แค่รุ่นเดียว (ทำงานคู่กันในรุ่นเดียวกัน ถ้าต้องดูแลมากกว่า 1 รุ่น ต้องให้ผู้ดูแลระบบแก้ไขเพิ่มให้
      // ภายหลังผ่าน allow update ซึ่งไม่ถูกจำกัดจำนวนแบบนี้) ส่วน GK Coach และ Fitness Coach ดูแลได้หลายรุ่น
      // ตั้งแต่ตอนลงทะเบียนเลย เพราะมักดูแลนักกีฬา/ฟิตเนสของหลายรุ่นอายุในทีมเดียวกัน
      // ผู้บริหารทีมไม่ต้องระบุทั้งสองฟิลด์นี้ — (ตัดการใช้เบอร์โทรศัพท์ออกจากระบบเข้าสู่ระบบ/ลงทะเบียนแล้ว)
      allow create: if isSignedIn()
                     && request.auth.uid == coachId
                     && request.resource.data.keys().hasOnly(['name', 'email', 'role', 'status', 'createdAt', 'ageGroups', 'coachPosition'])
                     && request.resource.data.email == request.auth.token.email
                     // ชื่อเป็นข้อความอิสระที่ใครสมัครก็ตั้งได้ แล้วไปแสดงในหน้าอนุมัติของผู้ดูแลระบบ (กัน XSS อีกชั้นนอกจาก
                     // escapeHtml ฝั่งหน้าเว็บ): ต้องเป็นสตริง 1-60 ตัวอักษร และห้ามมี < หรือ >
                     && request.resource.data.name is string
                     && request.resource.data.name.size() >= 1
                     && request.resource.data.name.size() <= 60
                     && !request.resource.data.name.matches('.*[<>].*')
                     && request.resource.data.role in ['coach', 'executive', 'staff']
                     && request.resource.data.status == 'pending'
                     && (request.resource.data.role != 'coach'
                         || ('ageGroups' in request.resource.data
                             && request.resource.data.ageGroups is list
                             && request.resource.data.ageGroups.size() > 0
                             && request.resource.data.coachPosition in ['head_coach', 'assistant_coach', 'gk_coach', 'fitness_coach']
                             && (!(request.resource.data.coachPosition in ['head_coach', 'assistant_coach']) || request.resource.data.ageGroups.size() == 1)));
      // ผู้ดูแลระบบเท่านั้นที่อนุมัติ/กำหนด team หรือแก้ไข/ลบบัญชีได้ (ไม่จำกัดจำนวนรุ่นอายุแบบตอนลงทะเบียนเอง
      // ผู้ดูแลระบบจึงเป็นคนเดียวที่เพิ่มรุ่นอายุที่ 2 ให้ Head Coach ได้)
      // ผู้ดูแลระบบหลักแก้ได้ทุกฟิลด์ ส่วนทีมหลังบ้านที่มีสิทธิ์ coaches อนุมัติ/แก้/ลบได้เฉพาะบัญชีโค้ชและผู้บริหารทีม — ห้ามแตะ permissions/email
      // และห้ามเปลี่ยนบทบาทเป็นอย่างอื่นนอกจากสองบทบาทนี้ (กันไม่ให้เลื่อนขั้นตัวเองหรือคนอื่นเป็นแอดมิน/ทีมหลังบ้าน)
      allow update: if isAdmin()
                    || (hasPerm('coaches')
                        && resource.data.role in ['coach', 'executive']
                        && request.resource.data.role in ['coach', 'executive']
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['permissions', 'email']));
      allow delete: if isAdmin() || (hasPerm('coaches') && resource.data.role in ['coach', 'executive']);
    }

    match /players/{id} {
      allow read: if canViewAll() || (canViewTeam() && ownsTeam());
      allow create: if canManageAll() || (canManageTeam() && request.resource.data.team == myTeam());
      allow update: if canManageAll() || (canManageTeam() && ownsTeam() && request.resource.data.team == myTeam());
      allow delete: if canManageAll() || (canManageTeam() && ownsTeam());
    }

    match /sessions/{id} {
      allow read: if canViewAll() || (canViewTeam() && ownsTeam());
      allow create: if canManageAll() || (canManageTeam() && request.resource.data.team == myTeam());
      allow update: if canManageAll() || (canManageTeam() && ownsTeam());
      allow delete: if false;
    }

    match /attendance/{id} {
      allow read: if canViewAll() || (canViewTeam() && ownsTeam());
      allow create: if canManageAll() || (canManageTeam() && request.resource.data.team == myTeam());
      allow update: if canManageAll() || (canManageTeam() && ownsTeam() && request.resource.data.team == myTeam());
      allow delete: if false;
    }

    // รายงานการฝึกซ้อม (รายชื่อนักกีฬาที่ไม่ได้เข้าซ้อม + พิกัด GPS ตอนส่ง)
    // โค้ชสร้าง/แก้ไขได้เฉพาะรายงานของทีมตัวเอง ผู้บริหารทีมดูได้อย่างเดียว (canViewTeam)
    match /trainingReports/{id} {
      allow read: if canViewAll() || (canViewTeam() && ownsTeam());
      allow create: if canManageAll() || (canManageTeam() && request.resource.data.team == myTeam());
      allow update: if canManageAll() || (canManageTeam() && ownsTeam() && request.resource.data.team == myTeam());
      allow delete: if isAdmin();
    }

    // รายงานผลการแข่งขัน — โค้ชจัดการได้เฉพาะรายการของทีมตัวเอง ผู้บริหารทีมดูได้อย่างเดียว
    match /matchReports/{id} {
      allow read: if canViewAll() || (canViewTeam() && ownsTeam());
      allow create: if canManageAll() || (canManageTeam() && request.resource.data.team == myTeam());
      allow update: if canManageAll() || (canManageTeam() && ownsTeam() && request.resource.data.team == myTeam());
      allow delete: if canManageAll() || (canManageTeam() && ownsTeam());
    }

    // รายงานอาการบาดเจ็บ — โค้ชจัดการได้เฉพาะรายการของทีมตัวเอง ผู้บริหารทีมดูได้อย่างเดียว
    match /injuryReports/{id} {
      allow read: if canViewAll() || (canViewTeam() && ownsTeam());
      allow create: if canManageAll() || (canManageTeam() && request.resource.data.team == myTeam());
      allow update: if canManageAll() || (canManageTeam() && ownsTeam() && request.resource.data.team == myTeam());
      allow delete: if canManageAll() || (canManageTeam() && ownsTeam());
    }

    // นัดประชุมโค้ชรายสัปดาห์ (1 เอกสาร = 1 ทีม × 1 สัปดาห์ของเดือน) — ผู้ดูแลระบบหลักสร้าง/ลบ/ใส่ลิงก์ Meet/บันทึกผลเข้าประชุม/แบ่งกลุ่ม
    // ทีมหลังบ้านที่มีสิทธิ์ meetings แก้ได้เฉพาะ sections (วาระ+ไฟล์แนบ) กับ updatedAt เท่านั้น
    // โค้ชและผู้บริหารทีมอ่านได้เฉพาะของทีมตัวเอง (query ต้องมี where('team','==',ทีมตัวเอง) ตามหมายเหตุด้านบน)
    match /coachMeetings/{id} {
      allow read: if canViewAll() || hasPerm('meetings') || (canViewTeam() && ownsTeam());
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
                    || (hasPerm('meetings')
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sections', 'updatedAt']));
    }

    // "รับทราบสรุปการประชุม" ของโค้ช (1 คน 1 นัด id = {meetingId}_{uid}) — โค้ชสร้างได้เฉพาะของตัวเอง แก้/ลบไม่ได้ ผู้ดูแลระบบอ่านได้ทั้งหมด
    // โค้ช/ผู้บริหารทีมอ่านได้เฉพาะของทีมตัวเอง (query ต้องมี where('team','==',ทีมตัวเอง))
    match /coachMeetingAcks/{id} {
      allow read: if canViewAll() || (canViewTeam() && ownsTeam());
      allow create: if isAdmin()
                    || (canManageTeam()
                        && request.resource.data.coachId == request.auth.uid
                        && request.resource.data.team == myTeam()
                        && id == request.resource.data.meetingId + '_' + request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // งานหลังประชุมของโค้ชแต่ละคน (ความรู้ที่ได้ + นำไปใช้ในสนาม) id = {meetingId}_{coachId} — โค้ชสร้าง/แก้ได้เฉพาะของตัวเอง
    // (แก้ได้แค่ know/use/updatedAt) อ่านได้เฉพาะของตัวเอง (query ต้องมี where('team',...) และ where('coachId','==',uid))
    // ผู้ดูแลระบบหลัก (และทีมหลังบ้านสิทธิ์ manageTeams) กรอก/แก้แทนโค้ชได้เหมือนข้อมูลอื่นในโหมดจัดการทีม
    // ทีมหลังบ้านที่มีสิทธิ์ meetings อ่านได้ทั้งหมด ลบได้เฉพาะแอดมินหลัก
    match /coachMeetingRecaps/{id} {
      allow read: if canManageAll() || hasPerm('meetings')
                  || (canManageTeam() && resource.data.coachId == request.auth.uid);
      allow create: if (canManageAll()
                        || (canManageTeam()
                            && request.resource.data.coachId == request.auth.uid
                            && request.resource.data.team == myTeam()))
                    && request.resource.data.keys().hasOnly(['team', 'meetingId', 'coachId', 'coachName', 'month', 'know', 'use', 'submittedOn', 'createdAt', 'updatedAt'])
                    && id == request.resource.data.meetingId + '_' + request.resource.data.coachId
                    && request.resource.data.know is string && request.resource.data.know.size() > 0 && request.resource.data.know.size() <= 2000
                    && request.resource.data.use is string && request.resource.data.use.size() > 0 && request.resource.data.use.size() <= 2000;
      allow update: if (canManageAll() || (canManageTeam() && resource.data.coachId == request.auth.uid))
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['know', 'use', 'updatedAt'])
                    && request.resource.data.know is string && request.resource.data.know.size() > 0 && request.resource.data.know.size() <= 2000
                    && request.resource.data.use is string && request.resource.data.use.size() > 0 && request.resource.data.use.size() <= 2000;
      allow delete: if isAdmin();
    }

    // ความคิดเห็นหลังประชุมของแอดมิน/ทีมสต๊าฟ (1 นัด 1 เอกสาร id = meetingId, comments.<สาย>) — โค้ชอ่านไม่ได้เลย
    match /coachMeetingComments/{id} {
      allow read: if isAdmin() || hasPerm('meetings');
      allow create, update: if (isAdmin() || hasPerm('meetings'))
                            && request.resource.data.keys().hasOnly(['meetingId', 'team', 'month', 'comments', 'updatedAt', 'updatedBy']);
      allow delete: if isAdmin();
    }

    // แผนการฝึกซ้อมรายวัน — โค้ชจัดการได้เฉพาะแผนของทีมตัวเอง ผู้บริหารทีมดูได้อย่างเดียว
    match /trainingPlans/{id} {
      allow read: if canViewAll() || (canViewTeam() && ownsTeam());
      allow create: if canManageAll() || (canManageTeam() && request.resource.data.team == myTeam());
      allow update: if canManageAll() || (canManageTeam() && ownsTeam() && request.resource.data.team == myTeam());
      allow delete: if canManageAll() || (canManageTeam() && ownsTeam());
    }

    // ข้อความที่ผู้ดูแลระบบส่งถึงทีม (เช่น แจ้งนักกีฬาที่มีพัฒนาการดี หรือแจ้งปัญหาของโค้ช) — ส่งได้เฉพาะ
    // ผู้ดูแลระบบเท่านั้น โค้ช/ผู้บริหารทีมของทีมนั้นอ่านได้และแก้ไขได้แค่ทำเครื่องหมายว่าอ่านแล้ว (read: true)
    match /executiveNotes/{id} {
      allow read: if canViewAll() || (canViewTeam() && ownsTeam());
      allow create: if isAdmin();
      allow update: if isAdmin() || (canViewTeam() && ownsTeam());
      allow delete: if isAdmin();
    }

    // สถานะ "อ่านแล้ว" ของการแจ้งเตือนแต่ละหมวดสำหรับผู้ดูแลระบบ (1 เอกสารต่อหมวด เช่น pending_accounts,
    // severe_injuries) — เฉพาะผู้ดูแลระบบเท่านั้นที่เข้าถึงได้ เพราะระบบแจ้งเตือนนี้มีไว้สำหรับผู้ดูแลระบบเท่านั้น
    match /adminNotificationReads/{key} {
      allow read, write: if isAdmin();
    }

    // การประเมิน MASC (Motricity/Availability/Smart/Commitment) — โปรไฟล์สรุปนักกีฬาเชิงลึกแยกตามตำแหน่ง/
    // ช่วงวัย เป็นระยะ (คนละระบบกับการประเมินรายวันใน attendance) โค้ชจัดการได้เฉพาะของทีมตัวเอง ผู้บริหารทีม
    // ดูได้อย่างเดียว
    //
    // โค้ชสร้าง/แก้ไข/ลบได้เฉพาะตอนมีรอบที่ผู้ดูแลระบบกำหนดและกำลังดำเนินการอยู่จริง (วันนี้ตามเวลาไทย UTC+7 อยู่ในช่วง
    // startDate–endDate — ตรงกับที่ masc.js เช็คด้วย todayBangkok()) โดยเอกสารต้องอ้างรอบนั้นผ่านฟิลด์ roundId
    // (id ของเอกสารใน mascRounds) เพราะ rules ค้นหารอบเองไม่ได้ ต้องรู้ id ก่อนถึงจะ get() ได้ — ไม่บังคับให้
    // assessmentPeriod ตรงกับ label ของรอบ เพื่อคงพฤติกรรมเดิมที่โค้ชประเมินย้อนหลังช่วงอื่นได้ตราบใดที่มีรอบเปิดอยู่
    // เอกสารเก่าก่อนมี roundId ลบไม่ได้จนกว่าจะบันทึกทับ (masc.js ประทับ roundId ให้ก่อนลบโดยอัตโนมัติ)
    function pad2(n) { return n < 10 ? '0' + string(n) : string(n); }
    // วันที่ตามเวลาไทย (UTC+7 ไม่มี DST) รูปแบบ "YYYY-MM-DD" — ต้องตรงกับ todayBangkok() ใน js/ui-utils.js
    function todayBangkok() {
      return string((request.time + duration.value(7, 'h')).year()) + '-'
             + pad2((request.time + duration.value(7, 'h')).month()) + '-'
             + pad2((request.time + duration.value(7, 'h')).day());
    }
    function isActiveMascRound(roundId) {
      return roundId is string
             && exists(/databases/$(database)/documents/mascRounds/$(roundId))
             && get(/databases/$(database)/documents/mascRounds/$(roundId)).data.startDate <= todayBangkok()
             && todayBangkok() <= get(/databases/$(database)/documents/mascRounds/$(roundId)).data.endDate;
    }
    match /playerEvaluations/{id} {
      allow read: if canViewAll() || (canViewTeam() && ownsTeam());
      allow create: if canManageAll() || (canManageTeam() && request.resource.data.team == myTeam()
                                     && isActiveMascRound(request.resource.data.get('roundId', null)));
      allow update: if canManageAll() || (canManageTeam() && ownsTeam() && request.resource.data.team == myTeam()
                                     && isActiveMascRound(request.resource.data.get('roundId', null)));
      allow delete: if canManageAll() || (canManageTeam() && ownsTeam()
                                     && isActiveMascRound(resource.data.get('roundId', null)));
    }

    // คำเห็นของโค้ชในสมุดพกนักกีฬา (รายงานผลรายบุคคลรอบ 3 เดือนสำหรับผู้ปกครอง) — ผู้ดูแลระบบเป็นคนสร้าง/
    // แก้ไขทั้งหมด (เลือกทีม/รุ่นอายุแล้วพิมพ์ทั้งชุด) จึงจำกัดเฉพาะผู้ดูแลระบบเท่านั้น ไม่เปิดให้โค้ชเขียนตรงๆ
    // เอกสารแยกตามช่วงเวลา (playerId+startMonth+endMonth) เพื่อไม่ให้คำเห็นรอบเก่าถูกทับตอนสร้างรอบใหม่
    match /playerReportCards/{id} {
      // ทีมหลังบ้านที่มีสิทธิ์ดู อ่านสมุดพกได้ (อ่านอย่างเดียว) — เขียนคำเห็นโค้ช/สรุปจากโค้ชฟิตเนสได้เฉพาะผู้ดูแลระบบหลัก
      allow read: if canViewAll();
      allow write: if isAdmin();
    }

    // รอบทดสอบสมรรถภาพ (Baseline/Monitoring/Re-evaluation/Final) ที่ผู้ดูแลระบบเปิด — โค้ช/ผู้บริหารทีมอ่านได้เพื่อรู้ว่ารอบไหนเปิดอยู่
    // แก้ไข/สร้าง/ลบได้เฉพาะผู้ดูแลระบบ
    match /fitnessRounds/{id} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // ผลทดสอบสมรรถภาพ 1 เอกสาร ต่อนักกีฬา ต่อรอบ (id = {roundId}_{playerId}) — โค้ชกรอก/แก้ได้เฉพาะนักกีฬาของทีมตัวเองและเฉพาะรอบที่
    // แอดมินยังเปิดอยู่จริง (status = open และวันนี้ตามเวลาไทยอยู่ในช่วงวันเปิด–ทดสอบซ่อมถึง) เหมือนกติกาของรอบ MASC ด้านบน
    // ส่วนที่ว่า "ช่วงซ่อมแก้ได้เฉพาะคนที่ยังไม่มีผล" บังคับที่หน้าเว็บ — ผู้บริหารทีมดูได้อย่างเดียว ลบได้เฉพาะผู้ดูแลระบบ
    function isOpenFitnessRound(roundId) {
      return roundId is string
             && exists(/databases/$(database)/documents/fitnessRounds/$(roundId))
             && get(/databases/$(database)/documents/fitnessRounds/$(roundId)).data.status == 'open'
             && get(/databases/$(database)/documents/fitnessRounds/$(roundId)).data.openDate <= todayBangkok()
             && todayBangkok() <= get(/databases/$(database)/documents/fitnessRounds/$(roundId)).data.makeupUntil;
    }
    match /fitnessResults/{id} {
      allow read: if canViewAll() || (canViewTeam() && ownsTeam());
      allow create: if canManageAll() || (canManageTeam() && request.resource.data.team == myTeam()
                                     && id == request.resource.data.roundId + '_' + request.resource.data.playerId
                                     && isOpenFitnessRound(request.resource.data.get('roundId', null)));
      allow update: if canManageAll() || (canManageTeam() && ownsTeam() && request.resource.data.team == myTeam()
                                     && isOpenFitnessRound(resource.data.get('roundId', null)));
      allow delete: if isAdmin();
    }
    // รอบการประเมิน MASC ที่ผู้ดูแลระบบกำหนด (ช่วงวันที่เริ่ม-สิ้นสุด ใช้ทั้งองค์กรพร้อมกันทุกทีม) — โค้ช/
    // ผู้บริหารทีมทุกคนต้องอ่านได้เพื่อเห็นรอบปัจจุบันในหน้า MASC ของตัวเอง แก้ไข/สร้างได้เฉพาะผู้ดูแลระบบ
    match /mascRounds/{id} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }
  }
}
